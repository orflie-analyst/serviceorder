rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return logado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuUsuario().isAdmin == true;
    }

    function souPrestadorDe(departamentoId) {
      return logado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        departamentoId in meuUsuario().departamentosPrestador;
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souAdmin());
      allow create: if souAdmin();
      // Usuário comum só pode alterar campos que não sejam de permissão.
      allow update: if souAdmin() ||
        (logado() && request.auth.uid == uid &&
          request.resource.data.isAdmin == resource.data.isAdmin &&
          request.resource.data.departamentosPrestador == resource.data.departamentosPrestador);
      allow delete: if souAdmin();
    }

    match /departamentos/{deptId} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    match /ordens/{osId} {
      allow read: if logado() && (
        resource.data.solicitanteId == request.auth.uid ||
        souPrestadorDe(resource.data.departamentoId) ||
        souAdmin()
      );

      allow create: if logado() &&
        request.resource.data.solicitanteId == request.auth.uid &&
        request.resource.data.status == 'aberta' &&
        request.resource.data.concluidoEm == null;

      // Solicitante não edita depois de criada; só prestador do departamento ou admin.
      allow update: if logado() && (
        souPrestadorDe(resource.data.departamentoId) || souAdmin()
      );

      allow delete: if souAdmin();

      match /notas/{notaId} {
        allow read: if logado() && (
          get(/databases/$(database)/documents/ordens/$(osId)).data.solicitanteId == request.auth.uid ||
          souPrestadorDe(get(/databases/$(database)/documents/ordens/$(osId)).data.departamentoId) ||
          souAdmin()
        );

        allow create: if logado() &&
          request.resource.data.autorId == request.auth.uid && (
            get(/databases/$(database)/documents/ordens/$(osId)).data.solicitanteId == request.auth.uid ||
            souPrestadorDe(get(/databases/$(database)/documents/ordens/$(osId)).data.departamentoId) ||
            souAdmin()
          );

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
